<?xml version="1.0" encoding="utf-8"?>
<!-- 맛집 추천 위젯. 상단 띠(탭→맛집 화면, 크게) + 하단 카드(근처 추천, 탭→네이버지도). RemoteViews 호환 뷰만. -->
<!-- 세로는 wrap_content 로 내용에 딱 맞춰 최소화(아래 빈칸 방지). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- 상단 띠(2배 크게): 제목 + 다음(🔄). 탭하면 맛집 화면으로. -->
    <LinearLayout
        android:id="@+id/widget_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🍽 맛집 찾기"
            android:textColor="#FFD9480F"
            android:textStyle="bold"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄"
            android:textSize="15sp"
            android:paddingStart="10dp"
            android:paddingEnd="4dp" />
    </LinearLayout>

    <!-- 구분선(RemoteViews 는 기본 View 미지원 → LinearLayout 로 얇은 선) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:orientation="horizontal"
        android:background="@drawable/widget_divider" />

    <!-- 하단 카드: 상단 정렬로 위아래 공백 최소화. -->
    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp">

        <ImageView
            android:id="@+id/widget_photo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/widget_photo_bg"
            android:scaleType="centerCrop"
            android:contentDescription="맛집 사진" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/widget_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="불러오는 중…"
                android:textColor="#FF212121"
                android:textStyle="bold"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_addr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FF888888"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="3dp" />

            <TextView
                android:id="@+id/widget_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FF777777"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="3dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
