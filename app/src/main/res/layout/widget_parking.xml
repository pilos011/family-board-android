<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 주차 위치. 남색 전체 배경. 데이터: 모닝(아이보리)·그랜저(흰색) 층을 가운데로 모아 표시
     (사이 간격은 parking_gap 가중치로 조절). 대기: "주차/확인" 두 줄. 탭→조회. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parking_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_parking_solid"
    android:padding="2dp">

    <!-- 대기: "주차/확인" 두 줄 -->
    <TextView
        android:id="@+id/parking_click"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:lineSpacingMultiplier="0.95"
        android:includeFontPadding="false"
        android:textColor="#FFEAD79A"
        android:textStyle="bold"
        android:textSize="28sp"
        android:visibility="gone"
        android:text="주차\n확인" />

    <!-- 모닝(첫째 줄): 진한 아이보리, 아래쪽 정렬(간격 쪽으로) -->
    <TextView
        android:id="@+id/parking_morning"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"
        android:gravity="center_horizontal|bottom"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:textColor="#FFEAD79A"
        android:textStyle="bold"
        android:textSize="34sp"
        android:text="B2" />

    <!-- 두 층 사이 간격(가중치로 조절) -->
    <LinearLayout
        android:id="@+id/parking_gap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3" />

    <!-- 그랜저(둘째 줄): 흰색, 위쪽 정렬(간격 쪽으로) -->
    <TextView
        android:id="@+id/parking_grandeur"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"
        android:gravity="center_horizontal|top"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="34sp"
        android:text="B4" />
</LinearLayout>
