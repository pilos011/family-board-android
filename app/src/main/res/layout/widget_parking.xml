<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 주차 위치. 두 모드: (조회값) 1:B2 / 2:B4 두 줄  |  (20분 경과) 큰 "클릭" 한 줄. 탭→조회. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parking_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_parking_bg"
    android:padding="4dp">

    <!-- 20분 경과/확인 필요: 큰 글씨 한 줄 -->
    <TextView
        android:id="@+id/parking_click"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textColor="#FFFFD54F"
        android:textStyle="bold"
        android:textSize="26sp"
        android:visibility="gone"
        android:text="클릭" />

    <!-- 조회값: 1 : B2 -->
    <TextView
        android:id="@+id/parking_morning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:text="1 : B2" />

    <!-- 조회값: 2 : B4 -->
    <TextView
        android:id="@+id/parking_grandeur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="3dp"
        android:text="2 : B4" />
</LinearLayout>
